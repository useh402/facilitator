# HumanAPI facilitator in Docker. Copy to .env.docker and fill in. Never commit .env.docker.
HF_ENV=mainnet
HF_SETTLE_TOKEN=                     # must equal HA_FACILITATOR_SETTLE_TOKEN of the task service
HF_ROBINHOOD_ENABLED=true
HF_ROBINHOOD_NETWORK=eip155:4663
HF_ROBINHOOD_PRIVATE_KEY=            # pays gas for settlements; fund it with ETH on Robinhood Chain
HF_SOLANA_ENABLED=false
