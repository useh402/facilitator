# HumanAPI facilitator. Copy to .env. Never commit .env.
HF_ENV=testnet                       # local | testnet | mainnet
HF_PORT=8402
HF_DATABASE_URL=sqlite:///./facilitator.db   # or postgresql://user:pass@host:5432/db
HF_SETTLE_TOKEN=change-me            # bearer token the task API sends on POST /settle
HF_RATE_LIMIT_PER_MINUTE=120
HF_DAILY_SETTLEMENT_CAP=5000
HF_OWNER_ADDRESS=                    # where scripts/withdraw.py sends the signer's leftover gas

# Robinhood Chain: USDG through the x402 Permit2 proxy (both contracts are live on 4663 and 46630)
HF_ROBINHOOD_ENABLED=true
HF_ROBINHOOD_NETWORK=eip155:46630    # eip155:4663 on mainnet
HF_ROBINHOOD_RPC_URL=                # default: the public RPC for the network
HF_ROBINHOOD_PRIVATE_KEY=            # pays gas for settle; fund it with the native token
HF_ROBINHOOD_ASSETS=                 # comma separated token addresses; empty = USDG on mainnet, any on testnet
HF_ROBINHOOD_CONFIRMATIONS=3
HF_ROBINHOOD_MAX_AMOUNT=1000000000   # 1000 USDG, atomic units

# Solana: USDC through the SVM exact scheme, this key is the fee payer
HF_SOLANA_ENABLED=true
HF_SOLANA_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1   # devnet; mainnet is solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
HF_SOLANA_RPC_URL=
HF_SOLANA_PRIVATE_KEY=               # base58 keypair; fund it with SOL
HF_SOLANA_ASSETS=                    # empty = USDC mint of the network
HF_SOLANA_MAX_AMOUNT=1000000000
